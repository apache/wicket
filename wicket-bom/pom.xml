<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.apache.wicket</groupId>
		<artifactId>wicket-parent</artifactId>
		<version>12.0.0-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<artifactId>wicket-bom</artifactId>
	<packaging>pom</packaging>
	<name>Wicket BOM</name>
	<description>Manages the versions of the Wicket modules, and of no third-party libraries.</description>
	<!--
		The published BOM is generated by bom-builder3 from the modules of the reactor and replaces
		this POM on install and deploy. It has no parent, so the dependency management of
		wicket-parent does not come along. Reactor modules are included unless excluded below.
	-->
	<build>
		<plugins>
			<plugin>
				<groupId>eu.maveniverse.maven.plugins</groupId>
				<artifactId>bom-builder3</artifactId>
				<executions>
					<execution>
						<id>build-bom</id>
						<goals>
							<goal>build-bom</goal>
						</goals>
						<configuration>
							<attach>true</attach>
							<bomName>${project.name}</bomName>
							<bomDescription>${project.description}</bomDescription>
							<!-- include the wicket umbrella POM -->
							<includePoms>true</includePoms>
							<dependencyExclusions>
								<!-- the BOM itself, parent and aggregator POMs -->
								<exclusion>
									<groupId>org.apache.wicket</groupId>
									<artifactId>wicket-bom</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.apache.wicket</groupId>
									<artifactId>wicket-parent</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.apache.wicket</groupId>
									<artifactId>wicket-native-websocket</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.apache.wicket.experimental.wicket12</groupId>
									<artifactId>wicket-experimental</artifactId>
								</exclusion>
								<!-- not consumed as dependencies -->
								<exclusion>
									<groupId>org.apache.wicket</groupId>
									<artifactId>wicket-archetype-quickstart</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.apache.wicket</groupId>
									<artifactId>wicket-examples</artifactId>
								</exclusion>
								<!-- not published -->
								<exclusion>
									<groupId>org.apache.wicket</groupId>
									<artifactId>wicket-benchmarks</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.apache.wicket</groupId>
									<artifactId>wicket-cdi-tests</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.apache.wicket</groupId>
									<artifactId>wicket-common-tests</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.apache.wicket</groupId>
									<artifactId>wicket-core-tests</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.apache.wicket</groupId>
									<artifactId>wicket-coverage</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.apache.wicket</groupId>
									<artifactId>wicket-js-tests</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.apache.wicket</groupId>
									<artifactId>wicket-user-guide</artifactId>
								</exclusion>
							</dependencyExclusions>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
